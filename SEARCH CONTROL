  f.addEventListener('submit',function(e){e.preventDefault();if(!f.checkValidity()){f.reportValidity();return}f.classList.add('enviado')});
})();

/* Calculadora de impacto: clientes desviados × conversión = pedidos; × ticket = ventas; × coste por cliente = captación desperdiciada. */
(function(){
  var f=document.getElementById('calc'); if(!f) return;
  var r={vis:f.querySelector('#r-vis'),conv:f.querySelector('#r-conv'),tick:f.querySelector('#r-tick'),cac:f.querySelector('#r-cac')};
  var o={vis:f.querySelector('#o-vis'),conv:f.querySelector('#o-conv'),tick:f.querySelector('#o-tick'),cac:f.querySelector('#o-cac')};
  var s={ped:f.querySelector('#s-ped'),ven:f.querySelector('#s-ven'),cap:f.querySelector('#s-cap'),anio:f.querySelector('#s-anio')};
  var es=new Intl.NumberFormat('es-ES',{maximumFractionDigits:0});
  function eur(n){return es.format(Math.round(n))+' €'}
  function calc(){
    var vis=+r.vis.value,conv=+r.conv.value/100,tick=+r.tick.value,cac=+r.cac.value;
    var ped=vis*conv,ven=ped*tick,cap=ped*cac;
    o.vis.textContent=es.format(vis); o.conv.textContent=(+r.conv.value).toLocaleString('es-ES',{minimumFractionDigits:1,maximumFractionDigits:1})+' %';
    o.tick.textContent=eur(tick); o.cac.textContent=eur(cac);
    s.ped.textContent=es.format(Math.round(ped)); s.ven.textContent=eur(ven); s.cap.textContent=eur(cap); s.anio.textContent=eur((ven+cap)*12);
  }
  Object.keys(r).forEach(function(k){r[k].addEventListener('input',calc)});
  f.addEventListener('submit',function(e){e.preventDefault()});
  calc();
})();

/* Visor del informe real: se desplaza solo, como un vídeo. */
(function(){
  "use strict";
  var reduceMov=window.matchMedia&&window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll("[data-visor]").forEach(function(visor){
    var pantalla=visor.querySelector(".visor__pantalla"),barra=visor.querySelector(".visor__progreso i"),boton=visor.querySelector("[data-visor-pausa]");
    var vel=parseFloat(visor.getAttribute("data-velocidad")||"70");
    var pausado=reduceMov,visible=false,encima=false,esperaHasta=0,finHasta=0,ultimo=0,pos=0;
    function maximo(){return Math.max(0,pantalla.scrollHeight-pantalla.clientHeight)}
    function progreso(){var m=maximo();barra.style.width=(m?(pantalla.scrollTop/m)*100:0)+"%"}
    function marcar(){visor.setAttribute("data-pausado",pausado?"true":"false");boton.setAttribute("aria-label",pausado?visor.getAttribute("data-txt-reanudar"):visor.getAttribute("data-txt-pausar"))}
    function paso(t){
      var dt=ultimo?Math.min(0.1,(t-ultimo)/1000):0; ultimo=t;
      if(!pausado&&visible&&!encima&&!document.hidden&&t>esperaHasta){
        var m=maximo();
        if(m>0&&pos>=m-1){ if(!finHasta)finHasta=t+2500; else if(t>finHasta){finHasta=0;pos=0;pantalla.scrollTop=0;esperaHasta=t+1500} }
        else if(m>0){pos=Math.min(m,pos+vel*dt);pantalla.scrollTop=pos}
      }
      progreso(); window.requestAnimationFrame(paso);
    }
    function manual(){pos=pantalla.scrollTop;finHasta=0;esperaHasta=performance.now()+4000}
    pantalla.addEventListener("wheel",manual,{passive:true});
    pantalla.addEventListener("touchstart",manual,{passive:true});
    pantalla.addEventListener("pointerdown",manual);
    pantalla.addEventListener("keydown",manual);
    pantalla.addEventListener("scroll",function(){if(Math.abs(pantalla.scrollTop-pos)>2)pos=pantalla.scrollTop;progreso()},{passive:true});
    visor.addEventListener("mouseenter",function(){encima=true});
    visor.addEventListener("mouseleave",function(){encima=false;pos=pantalla.scrollTop});
    boton.addEventListener("click",function(){pausado=!pausado;pos=pantalla.scrollTop;marcar()});
    if("IntersectionObserver" in window){new IntersectionObserver(function(e){visible=e[0].isIntersecting},{threshold:0.35}).observe(visor)}else{visible=true}
    marcar(); window.requestAnimationFrame(paso);
  });
})();
</script>
