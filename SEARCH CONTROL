<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Análisis gratis de resultados de Google</title>
<meta name="description" content="Análisis gratis de los resultados de Google que imitan tu marca cuando te buscan. Listo en menos de 24 horas, sin compromiso.">
</head>
<body>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* ──────────────────────────────────────────────────────────────────────────
   LANDING GOOGLE ADS · SEARCH CONTROL (proteccion-de-marca) · v3 final
   Tema único, claro. Una columna de 1160 px; hero sobre «cielo» con el
   formulario; el informe se enseña con el visor real y tres CAPAS apiladas
   (resultados · impacto con calculadora · acciones). Tokens de sp-tokens.css.
   La versión para HubSpot (todo embebido) la genera empaquetar.py.
   ────────────────────────────────────────────────────────────────────────── */
@font-face{font-family:'MSCHN';src:url('data:font/woff2;base64,') format('woff2-variations'),url('data:font/woff2;base64,') format('woff2');font-weight:300 700;font-style:normal;font-display:swap}

:root{
  color-scheme:light;
  --bg:#FFFFFF; --bg-subtle:#F5F7FC; --surface:#F4F6FF; --surface-2:#E9EFFF;
  --fg:#0E1013; --fg-2:#454B59; --fg-3:#6D7382;
  --line:#DDE1E9; --line-accent:#DEE7FE; --line-strong:#C2C7D1;
  --accent:#255EFD; --accent-hover:#1A4BD8; --accent-soft:#E9EFFF; --on-accent:#FFFFFF;
  --iris:#958DFD;
  --grad-material:linear-gradient(135deg,#958DFD 0%,#255EFD 100%);
  --glass:rgba(255,255,255,.20); --glass-line:rgba(255,255,255,.45);
  --inverse-bg:#0E1013; --inverse-fg:#F5F7FC; --inverse-fg-2:#C2C7D1; --inverse-line:#454B59;
  --risk-crit-bg:#FFE6E7; --risk-crit-dot:#FF5555; --risk-crit-text:#E52E2E;
  --risk-high-bg:#FFEFDE; --risk-high-dot:#FF9327; --risk-high-text:#D66B00;
  --risk-med-bg:#F8F3CB;  --risk-med-dot:#EFC800;  --risk-med-text:#CCA000;
  --ok-bg:#E8FACD; --ok-dot:#67D953; --ok-text:#1EB200;
  --sombra:0 24px 60px rgba(14,16,19,.12);
  --font-display:'MSCHN','Helvetica Neue',Helvetica,Arial,sans-serif;
  --font-body:'Golos Text','Helvetica Neue',Helvetica,Arial,sans-serif;
  --font-mono:'IBM Plex Mono',ui-monospace,'SFMono-Regular',Menlo,monospace;
  --wrap:1160px; --r-card:12px; --r-panel:16px; --r-btn:8px;
  --gx:max(16px,env(safe-area-inset-left,0px)); --gxr:max(16px,env(safe-area-inset-right,0px));
}

*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:16px;line-height:1.55;-webkit-font-smoothing:antialiased;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--bg)}
img{max-width:100%;display:block}
a{color:var(--accent)}
h1,h2,h3{font-family:var(--font-display);margin:0;text-wrap:balance;letter-spacing:0}
p{margin:0}
.wrap{max-width:var(--wrap);margin-inline:auto;padding-left:var(--gx);padding-right:var(--gxr)}
.sec{padding-block:clamp(56px,8vw,104px)}
.etiqueta{font-family:var(--font-mono);font-weight:500;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.etiqueta--inv{color:#fff}
.h2{font-size:clamp(30px,4vw,44px);font-weight:600;line-height:1.08;margin-top:14px;max-width:18ch}
.lead{font-size:18px;color:var(--fg-2);max-width:60ch;margin-top:16px}
.num{font-variant-numeric:tabular-nums}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5em;height:52px;padding:0 22px;border-radius:var(--r-btn);border:1px solid transparent;font:500 16px/1 var(--font-body);text-decoration:none;cursor:pointer;transition:background .15s,border-color .15s,color .15s}
.btn--principal{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.btn--principal:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}

/* ── Cabecera ─────────────────────────────────────────────────────────────── */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;height:68px;gap:16px}
.top img{height:30px;width:auto}
.top .btn{height:42px;padding:0 16px;font-size:14px}

/* ── Hero sobre cielo ─────────────────────────────────────────────────────── */
.hero{position:relative;color:#fff;background:var(--grad-material);overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background:url('data:image/jpeg;base64,') center/cover no-repeat}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(14,16,19,.10),rgba(14,16,19,.38))}
.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(32px,5vw,72px);align-items:center;padding-block:clamp(48px,7vw,96px)}
.hero h1{font-size:clamp(36px,5.2vw,60px);font-weight:600;line-height:1.02;margin-top:16px;max-width:15ch;text-shadow:0 1px 2px rgba(14,16,19,.25)}
.hero .lead{color:rgba(255,255,255,.92);max-width:48ch;text-shadow:0 1px 2px rgba(14,16,19,.25)}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.chip{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 14px;border-radius:999px;background:var(--glass);border:1px solid var(--glass-line);font-size:14px;font-weight:500;backdrop-filter:blur(6px)}
.chip::before{content:"";width:8px;height:8px;border-radius:50%;background:#fff}
.hero-prueba{margin-top:34px;padding-top:22px;border-top:1px solid var(--glass-line);display:flex;gap:28px;flex-wrap:wrap}
.hero-prueba b{display:block;font-family:var(--font-display);font-size:30px;font-weight:600;line-height:1}
.hero-prueba span{display:block;font-size:13px;color:rgba(255,255,255,.88);max-width:24ch;margin-top:6px}

/* ── Formulario ───────────────────────────────────────────────────────────── */
.form{background:#fff;color:var(--fg);border-radius:var(--r-panel);padding:28px;box-shadow:0 24px 60px rgba(14,16,19,.22)}
.form h2{font-size:26px;font-weight:600;line-height:1.1}
.form .sub{color:var(--fg-2);font-size:14px;margin-top:8px}
.campos{display:grid;gap:12px;margin-top:20px}
.campo label{display:block;font-family:var(--font-mono);font-size:11px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;color:var(--fg-2);margin-bottom:6px}
.campo input{width:100%;height:46px;padding:0 14px;border:1px solid var(--line-strong);border-radius:8px;font:400 15px var(--font-body);color:var(--fg);background:#fff}
.campo input:focus{border-color:var(--accent);outline:none;box-shadow:0 0 0 3px var(--line-accent)}
.dos{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.consent{display:grid;gap:8px;margin-top:16px;font-size:13px;color:var(--fg-2)}
.consent label{display:flex;gap:10px;align-items:flex-start;line-height:1.4}
.consent input{margin-top:3px;accent-color:var(--accent);width:16px;height:16px;flex:none}
.form .btn{width:100%;margin-top:18px}
.form .nota{font-size:12px;color:var(--fg-3);margin-top:12px;text-align:center}
.form .ok{display:none;padding:20px;border-radius:12px;background:var(--accent-soft);margin-top:18px;font-size:15px}
.form.enviado .campos,.form.enviado .consent,.form.enviado .btn,.form.enviado .nota{display:none}
.form.enviado .ok{display:block}

/* ── El informe: visor + tres capas ───────────────────────────────────────── */
.informe{background:var(--bg-subtle)}
.informe-cabeza{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,5vw,72px);align-items:start}
.recibes{margin-top:26px;background:#fff;border:1px solid var(--line-accent);border-radius:var(--r-card);overflow:hidden}
.recibes>div{padding:18px 20px}
.recibes>div+div{border-top:1px solid var(--line)}
.recibes .tit{font-family:var(--font-mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);font-weight:500}
.recibes p{margin-top:6px;font-size:15px;line-height:1.45}
.recibes p b{font-weight:600}
.recibes ul{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
.recibes li{font-size:13px;padding:5px 11px;border-radius:999px;background:var(--surface);border:1px solid var(--line);color:var(--fg-2)}
.capas-intro{margin-top:clamp(48px,7vw,80px)}
.capas-intro h3{font-size:clamp(24px,3vw,32px);font-weight:600;line-height:1.1}
.capas-intro p{color:var(--fg-2);margin-top:10px;max-width:62ch}

/* visor del informe real: se desplaza solo, como un vídeo */
.visor{background:#fff;border:1px solid var(--line);border-radius:var(--r-panel);box-shadow:var(--sombra);overflow:hidden}
.visor__barra{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--surface);border-bottom:1px solid var(--line)}
.visor__puntos{display:flex;gap:5px}.visor__puntos i{width:8px;height:8px;border-radius:50%;background:var(--line-strong)}
.visor__titulo{flex:1;min-width:0;font-weight:500;font-size:13px;color:var(--fg-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.visor__marco{position:relative}
.visor__marco::after{content:"";position:absolute;left:0;right:0;bottom:0;height:48px;background:linear-gradient(to bottom,rgba(255,255,255,0),#fff);pointer-events:none}
.visor__pantalla{height:min(640px,72vh);overflow-y:auto;overscroll-behavior:contain;scrollbar-width:none;background:#fff}
.visor__pantalla::-webkit-scrollbar{display:none}
.visor__img{width:100%;height:auto}
.visor__pie{display:flex;align-items:center;gap:14px;padding:10px 16px;border-top:1px solid var(--line)}
.visor__boton{flex:none;width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:#fff;color:var(--fg);display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.visor__boton:hover{border-color:var(--accent)}
.visor .icono-play{display:none}
.visor[data-pausado="true"] .icono-pausa{display:none}.visor[data-pausado="true"] .icono-play{display:block}
.visor__progreso{flex:1;height:4px;border-radius:2px;background:var(--line);position:relative;overflow:hidden}
.visor__progreso i{position:absolute;inset:0 auto 0 0;width:0;background:var(--accent);border-radius:2px}
.visor__ayuda{font-size:13px;color:var(--fg-3);white-space:nowrap}
.visor-nota{display:flex;gap:8px;align-items:flex-start;margin-top:14px;font-size:14px;color:var(--fg-3)}
.visor-nota svg{flex:none;margin-top:3px}

.capas{display:grid;gap:24px;margin-top:28px}
.capa{position:sticky;top:calc(68px + env(safe-area-inset-top,0px) + var(--off));background:var(--bg);border:1px solid var(--line-accent);border-radius:var(--r-panel);padding:clamp(22px,3.5vw,40px);display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(24px,4vw,56px);box-shadow:0 -12px 40px rgba(14,16,19,.06)}
.capa:nth-child(1){--off:0px}.capa:nth-child(2){--off:28px}.capa:nth-child(3){--off:56px}
.capa:nth-child(2){background:var(--surface)}
.capa .n{font-family:var(--font-mono);font-size:12px;letter-spacing:.08em;color:var(--accent);font-weight:500}
.capa h3{font-size:clamp(24px,2.6vw,32px);font-weight:600;line-height:1.1;margin-top:10px}
.capa .que{color:var(--fg-2);margin-top:12px;max-width:38ch}
.incluye{list-style:none;padding:0;margin:18px 0 0;display:grid;gap:8px}
.incluye li{display:grid;grid-template-columns:18px 1fr;gap:10px;font-size:15px;line-height:1.4}
.incluye li::before{content:"";width:18px;height:18px;border-radius:50%;background:var(--accent-soft);border:1.5px solid var(--accent);margin-top:2px;box-shadow:inset 0 0 0 3px var(--bg)}
.capa:nth-child(2) .incluye li::before{box-shadow:inset 0 0 0 3px var(--surface)}

.visual{display:grid;gap:14px;min-width:0}
.flujo{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:10px;align-items:stretch}
.cifra{background:var(--surface);border:1px solid var(--line-accent);border-radius:var(--r-card);padding:16px;min-width:0}
.cifra b{display:block;font-family:var(--font-display);font-weight:600;font-size:clamp(26px,2.8vw,34px);line-height:1;color:var(--accent)}
.cifra small{display:block;font-size:13px;color:var(--fg-2);margin-top:8px;line-height:1.35}
.fuente{display:inline-flex;align-items:center;gap:6px;font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-3);margin-top:10px}
.fuente i{width:8px;height:8px;border-radius:2px}
.m{background:var(--accent)} .e{background:var(--iris)}
.flecha{align-self:center;color:var(--fg-3);font-size:20px}
.lista{background:var(--bg);border:1px solid var(--line);border-radius:var(--r-card);overflow:hidden}
.lista header{display:flex;flex-wrap:wrap;gap:6px 14px;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line);font-size:13px;color:var(--fg-2)}
.lista header b{color:var(--fg);font-weight:500}
.lista ol{list-style:none;margin:0;padding:0}
.lista li{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:10px 16px;font-size:14px}
.lista li+li{border-top:1px solid var(--line)}
.lista .pos{font-family:var(--font-mono);color:var(--fg-3);font-size:12px;min-width:26px}
.lista .url{color:var(--fg);min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500}
.lista .url small{display:block;color:var(--fg-3);font-size:12px;font-weight:400}
.badge{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:999px;font-size:12px;font-weight:500;white-space:nowrap}
.badge::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--d)}
.badge--crit{background:var(--risk-crit-bg);color:var(--risk-crit-text);--d:var(--risk-crit-dot)}
.badge--high{background:var(--risk-high-bg);color:var(--risk-high-text);--d:var(--risk-high-dot)}
.badge--med{background:var(--risk-med-bg);color:var(--risk-med-text);--d:var(--risk-med-dot)}
.badge--ok{background:var(--ok-bg);color:var(--ok-text);--d:var(--ok-dot)}
.paises{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px;color:var(--fg-2)}
.paises b{font-weight:500;color:var(--fg)}
.paises span{padding:4px 10px;border-radius:999px;background:var(--surface);border:1px solid var(--line)}

/* calculadora viva */
.calc{background:var(--bg);border:1px solid var(--line);border-radius:var(--r-card);padding:18px;display:grid;grid-template-columns:1.1fr .9fr;gap:18px}
.calc-cab{grid-column:1/-1;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:13px;color:var(--fg-2);padding-bottom:12px;border-bottom:1px solid var(--line)}
.calc-cab b{color:var(--fg);font-weight:500}
.ctrl{display:grid;gap:14px}
.ctrl label{display:grid;grid-template-columns:1fr auto;gap:4px 12px;font-size:14px;align-items:center}
.ctrl label em{font-style:normal;font-family:var(--font-mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-3);grid-column:1}
.ctrl label output{font-weight:600;font-variant-numeric:tabular-nums;grid-column:2;grid-row:1/3;font-size:16px;color:var(--accent)}
.ctrl input[type=range]{grid-column:1/-1;width:100%;accent-color:var(--accent);height:28px;margin:0}
.res{background:var(--surface);border-radius:10px;padding:16px;display:grid;gap:12px;align-content:start}
.res div{display:grid;gap:2px}
.res b{font-family:var(--font-display);font-size:26px;font-weight:600;line-height:1;color:var(--accent);font-variant-numeric:tabular-nums}
.res small{font-size:13px;color:var(--fg-2);line-height:1.35}
.res .total{border-top:1px solid var(--line-accent);padding-top:12px}
.res .total b{font-size:32px}
.areas{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.areas div{background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:12px;font-size:13px;line-height:1.35}
.areas b{display:block;font-weight:500;color:var(--fg);margin-bottom:4px}

.incluye li b{font-weight:600}

/* ── Caso real y testimonios ──────────────────────────────────────────────── */
.prueba{background:linear-gradient(135deg,#255EFD 0%,#958DFD 100%);color:#fff}
.prueba h2{color:#fff;max-width:22ch}
.cifras3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:36px}
.vidrio{background:var(--glass);border:1px solid var(--glass-line);border-radius:var(--r-card);padding:22px;backdrop-filter:blur(8px)}
.vidrio>b{display:block;font-family:var(--font-display);font-weight:600;font-size:clamp(34px,4vw,48px);line-height:1}
.vidrio>span{display:block;font-size:14px;margin-top:8px;color:rgba(255,255,255,.9)}
.prueba .ref{font-size:13px;color:rgba(255,255,255,.8);margin-top:14px;max-width:70ch}
.otros{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px 40px;align-items:end;margin-top:clamp(40px,6vw,64px)}
.otros h3{font-size:clamp(24px,3vw,32px);font-weight:600;color:#fff}
.otros p{color:rgba(255,255,255,.88);font-size:15px}
.testis{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:24px}
.testi{background:#fff;color:var(--fg);border-radius:var(--r-card);padding:22px;display:flex;flex-direction:column;gap:14px}
.testi .sector{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:500}
.testi .sector i{font-style:normal;padding:3px 10px;border-radius:999px;background:var(--fg);color:#fff;font-size:12px}
.testi q{quotes:"«" "»";font-size:15px;line-height:1.5;color:var(--fg-2)}
.testi footer{display:flex;gap:12px;align-items:center;margin-top:auto;font-size:13px;color:var(--fg-3)}
.testi footer img,.testi footer .ini{width:40px;height:40px;border-radius:50%;flex:none}
.testi footer .ini{display:grid;place-items:center;background:var(--accent-soft);color:var(--accent);font-weight:600}
.testi footer b{display:block;font-weight:500;color:var(--fg)}

/* ── Cómo funciona ────────────────────────────────────────────────────────── */
.pasos{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px;counter-reset:paso}
.paso{counter-increment:paso;padding:24px;border:1px solid var(--line);border-radius:var(--r-card);background:var(--bg)}
.paso:last-child{background:var(--surface);border-color:var(--line-accent)}
.paso::before{content:counter(paso);display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--accent-soft);color:var(--accent);font-family:var(--font-display);font-weight:600;font-size:16px}
.paso h3{font-family:var(--font-body);font-size:18px;font-weight:600;margin-top:16px}
.paso p{color:var(--fg-2);font-size:15px;margin-top:8px}
.centro{display:flex;justify-content:center;margin-top:36px}

/* ── Soluciones ───────────────────────────────────────────────────────────── */
.soluciones{background:var(--surface)}
.sol-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;grid-template-rows:auto auto;gap:14px;margin-top:40px}
.sol{background:#fff;border:1px solid var(--line-accent);border-radius:var(--r-card);padding:20px;display:grid;grid-template-columns:80px 1fr;gap:16px;align-items:start}
.sol img{width:80px;height:80px}
.sol h3{font-family:var(--font-body);font-size:17px;font-weight:600}
.sol p{color:var(--fg-2);font-size:14px;margin-top:6px}
.sol--principal{grid-row:1/3;border-color:var(--accent);grid-template-columns:1fr;align-content:start}
.sol--principal img{width:96px;height:96px}
.sol--principal h3{font-size:22px;font-family:var(--font-display)}
.sol--principal p{font-size:16px}
.sol--principal .etiqueta{margin-top:14px}

/* ── Preguntas ────────────────────────────────────────────────────────────── */
.faq{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:clamp(24px,5vw,72px)}
.faq details{border-top:1px solid var(--line);padding:18px 0}
.faq details:last-child{border-bottom:1px solid var(--line)}
